# Public address of the server (used for the links in the OPDS catalog)
PUBLIC_URL=https://your-domain.com
# 1 = registration open, 0 = closed
REGISTRATION_OPEN=1
# Optional: invite code required when signing up
INVITE_CODE=
# Only for plain Docker with docker-compose.caddy.yml: domain Caddy serves (no https://)
DOMAIN=your-domain.com
