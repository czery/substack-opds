{
  "manifest_version": 3,
  "name": "Substack → OPDS Sync",
  "version": "0.1.0",
  "description": "Automatically sends your substack.sid cookie to your OPDS server.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://substack.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Substack → OPDS" },
  "browser_specific_settings": {
    "gecko": {
      "id": "substack-opds-sync@techstance.de",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    }
  }
}
